# ==============================================================================
# MEDVAULT — FULL-STACK HEALTHCARE APPLICATION CONFIGURATION TEMPLATE
# Copy and configure .env files in server/ and client/ as shown below.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (server/.env)
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production')
NODE_ENV=development

# Express HTTP & WebSocket Port
PORT=5000

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated or single)
# In development: http://localhost:5173
# In production: https://your-medvault.netlify.app or https://your-medvault.vercel.app
CLIENT_URL=http://localhost:5173

# Secret key used for signing JWT tokens (use a strong random 256-bit string in prod)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars!

# JWT Token validity duration
JWT_EXPIRES_IN=7d

# MongoDB Connection URI (Local MongoDB Community or MongoDB Atlas URI)
# Local: mongodb://localhost:27017/medvault
# Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/medvault?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medvault

# Express Security Rate Limiter settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional Multi-Channel Notifications (Email & WhatsApp, Zero PHI)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="MedVault Health" <no-reply@medvault.health>

WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# FRONTEND (client/.env)
# ------------------------------------------------------------------------------
# URL of your Express REST backend API
VITE_API_URL=http://localhost:5000

# URL of your Socket.IO WebSocket server (typically same as backend URL)
VITE_SOCKET_URL=http://localhost:5000
