# MedVault Frontend Environment Configuration Template
# In development, these point to the local Express backend on port 5000.
# In production (e.g. Netlify/Vercel), point these to your deployed Render/cloud backend URL (e.g. https://medvault-api.onrender.com).

VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
