# MedVault Secure Server Environment Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=medvault_super_secure_jwt_secret_key_2026_x89!
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb://localhost:27017/medvault
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Multi-Channel Notifications (Optional)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="MedVault Health" <no-reply@medvault.health>

WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
